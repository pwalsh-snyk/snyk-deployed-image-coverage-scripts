# Copy to aws/.env (gitignored). Loaded after root .env — same key here wins.
# AWS credentials: aws configure, AWS_PROFILE, or standard env vars (see aws/README.md).

# Required for cluster discovery (omit if you only use --images-file)
# EKS_REGIONS=us-east-1,eu-west-1
# Or a single region:
# AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1
