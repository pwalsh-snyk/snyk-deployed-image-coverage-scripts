# Copy to .env in the repository root (gitignored). Shared by both entry scripts.
# Provider-specific variables live in azure/.env and aws/.env (see those folders).

# Required (Snyk)
SNYK_TOKEN=
SNYK_ORG_ID=
SNYK_INTEGRATION_ID=

# Optional registry routing (falls back to SNYK_INTEGRATION_ID)
# SNYK_INTEGRATION_ID_ACR=
# SNYK_INTEGRATION_ID_GCP=
# SNYK_INTEGRATION_ID_ECR=
# SNYK_INTEGRATION_ID_MCR=
# SNYK_INTEGRATION_ID_DOCKER_HUB=

# Optional Snyk API / tagging / cleanup
# SNYK_REST_BASE=https://api.snyk.io
# SNYK_V1_BASE=https://snyk.io
# SNYK_REST_VERSION=2024-10-15
# SNYK_TAG_IMPORTED_PROJECTS=1
# SNYK_IMPORT_TAG_KEY=image
# SNYK_IMPORT_TAG_VALUE=deployed
# SNYK_CLEANUP_REQUIRE_TAG=1
# SNYK_DEBUG=0
